# Copie este arquivo para .env e preencha com suas credenciais reais

# Segurança e Processamento
# ATENÇÃO: O sal padrão é público e DEVE ser substituído em produção
SAL_PSEUDONIMIZACAO=communitylab_default_salt
TAMANHO_MINIMO_TEXTO=10
LIMIAR_CONFIANCA=0.6
MAX_TENTATIVAS_LLM=2
TAMANHO_LOTE=50

# OCI Object Storage
OCI_BUCKET_NAME=G10communitylab-ativos
OCI_NAMESPACE=seu_namespace_aqui
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# Gemini API
GEMINI_API_KEY=sua_chave_gemini_aqui
