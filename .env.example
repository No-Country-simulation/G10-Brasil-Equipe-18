# Copie este arquivo para .env e preencha com suas credenciais reais

# Segurança e Processamento
# ATENÇÃO: O sal padrão é público e DEVE ser substituído em produção
SAL_PSEUDONIMIZACAO=communitylab_default_salt
TAMANHO_MINIMO_TEXTO=10
LIMIAR_CONFIANCA=0.6
MAX_TENTATIVAS_LLM=2
TAMANHO_LOTE=50

# Modo Demonstração
# Apenas para demonstração - NÃO deixar ligado em produção
# Valores: 1, true ou sim (qualquer outro desliga)
# MODO_DEMONSTRACAO=

# OCI Object Storage

OCI_USER=ocid1.user.oc1..seu_ocid
OCI_FINGERPRINT=seu_fingerprint_aqui
OCI_TENANCY=ocid1.tenancy.oc1..seu_ocid
OCI_REGION=sua_regiao_aqui
OCI_BUCKET_NAME=G10communitylab-ativos
OCI_NAMESPACE=seu_namespace_aqui
OCI_CONFIG_FILE=~/.oci/config
OCI_KEY_CONTENT=cole_sua_chave_privada_pem_aqui
OCI_PROFILE=DEFAULT

# Discord
DISCORD_TOKEN=seu_token_de_bot_discord_aqui
CANAL_ID=seu_id_de_canal_discord

# Gemini API
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL = gemini-3.6-flash

# Cohere API
COHERE_API_KEY=sua_chave_cohere_aqui
COHERE_MODEL=cohere.command-r-plus

# Groq API
GROQ_API_KEY =sua_chave_groq_aqui
GROQ_MODEL = llama-3.1-8b-instant
