# Copie este arquivo para secrets.toml e preencha com suas credenciais OCI reais
# ATENÇÃO: secrets.toml está no .gitignore e NUNCA deve ser commitado

# Credenciais OCI Object Storage
# Para deploy no Streamlit Cloud: configure em Settings > Secrets do app
OCI_USER = "ocid1.user.oc1..sua_ocid_de_usuario_aqui"
OCI_FINGERPRINT = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
OCI_TENANCY = "ocid1.tenancy.oc1..sua_ocid_de_tenancy_aqui"
OCI_REGION = "sa-saopaulo-1"

# Chave privada PEM (cole o conteúdo completo incluindo BEGIN e END)
# No Streamlit Cloud, cole como texto literal - as quebras de linha serão normalizadas automaticamente
OCI_KEY_CONTENT = """-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...
(cole aqui o conteúdo completo da sua chave privada)
...resto da chave...
-----END PRIVATE KEY-----"""

# Opcionais (o sistema usa valores padrão se omitidos)
# OCI_NAMESPACE = "seu_namespace_aqui"
# OCI_BUCKET_NAME = "G10communitylab-ativos"
